# ---------------------------------------------------------------------------
# Creator Outdoor - local development environment
# Copy to .env and adjust. Never commit .env.
# ---------------------------------------------------------------------------

# --- Product configuration (shared, non-secret) ----------------------------
TIMEZONE=America/Sao_Paulo
CURRENCY=BRL
MIN_BOOST_CENTS=500
MIN_INCREMENT_CENTS=100
ROTATION_HOURS=24
ROTATION_FEED_MAX=30
ROTATION_BUCKET_MINUTES=5
SUPPORTER_MESSAGE_MAX=140
SUPPORTER_NAME_MAX=40
SESSION_COOKIE_DAYS=90
SUPPORTER_COOKIE_DAYS=365
WEEK_START=MONDAY_00_00
LAUNCH_CATEGORY=musica
FAKE_PIX_EXPIRATION_MINUTES=30

# --- Rate limits (per client) ------------------------------------------------
# Defaults are the production values. An end-to-end suite or a load test raises
# them explicitly here; the code never disables rate limiting.
RATE_LIMIT_SUBMISSIONS_PER_HOUR=5
RATE_LIMIT_REPORTS_PER_HOUR=10
RATE_LIMIT_OPT_OUT_REQUESTS_PER_HOUR=5
RATE_LIMIT_OPT_OUT_VERIFICATIONS_PER_HOUR=20
RATE_LIMIT_BOOSTS_PER_HOUR=20
RATE_LIMIT_IMPRESSIONS_PER_MINUTE=240

# --- Origins ---------------------------------------------------------------
WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:3001
ADMIN_ORIGIN=http://localhost:3002

# --- apps/api --------------------------------------------------------------
API_PORT=3001
DATABASE_URL=postgres://creator_outdoor:creator_outdoor@localhost:5432/creator_outdoor
# Used only by `bun run test:integration`. Must NOT point at a database you care about.
TEST_DATABASE_URL=postgres://creator_outdoor:creator_outdoor@localhost:5432/creator_outdoor_test
# Server-only shared secret for apps/admin -> apps/api internal calls (Phase 2).
# Derives supporter grouping keys. Rotating it re-partitions the Torcida.
FAN_IDENTITY_SECRET=dev-fan-identity-secret-change-me-please-32b
ADMIN_API_SECRET=dev-admin-api-secret-change-me
# The named administrators, one entry each with a password hash and a TOTP secret.
# The value below is the hash of the development password "creator-outdoor-dev".
# Produce with: bun run admin:operator '<name>' '<password>'
# THIS ONE IS PUBLIC: its password is `creator-outdoor-dev` and its TOTP secret is
# below, so in production it is an account anybody on the internet can use.
# A production admin app refuses this operator's sign-in — by name, so whoever
# tries it is told why — while letting every real operator beside it work.
# Enrol one with: bun run admin:operator '<name>' '<password>'
ADMIN_OPERATORS=W3siaWQiOiJlZHUiLCJwYXNzd29yZEhhc2giOiJzY3J5cHQ6MTYzODQ6ODoxOk9rcXhLYTdpVUVqbXEzSWY2bDFTV0E6Y3BzMlNrbmJQbzFmMkV5bFdDRHRzLU4tNjQ3d0dxYVg3YmxRc3RvQWZoY1d0bzU3c01lNVlYRUdhVnppVnVERWFpM0hYSVVjRkpOTzZrQ0Uwcmp3TEEiLCJ0b3RwU2VjcmV0IjoiUVNSWlFBNFBTQVBCQkVLN0VSWkVCRFRJQldYWEVKVVYifV0
# 32+ bytes used to seal the administrator session cookie.
ADMIN_SESSION_SECRET=dev-admin-session-secret-change-me-please-32b

# --- apps/web --------------------------------------------------------------
WEB_PORT=3000

# --- apps/admin ------------------------------------------------------------
ADMIN_PORT=3002

# --- Production PIX (Mercado Pago) -------------------------------------------
# Absent here on purpose: without them the API runs the fake PIX provider, so a
# missing external credential never blocks local development or CI. A production
# process without them refuses to start rather than settling nothing quietly.
# MERCADO_PAGO_ACCESS_TOKEN=
# MERCADO_PAGO_WEBHOOK_SECRET=

# Production email. Without both the API uses the console provider, which
# delivers nothing; a production process without them refuses to start.
# RESEND_API_KEY=
# EMAIL_FROM_ADDRESS=Creator Outdoor <avisos@seu-dominio>

# Where failures are reported. Without it they are in the log and nowhere else,
# which is allowed: a process that refuses to boot without an error service is a
# worse outage than one whose failures are only in its own logs.
# SENTRY_DSN=https://<key>@<host>/<project>

# The E2E administrator, matching ADMIN_OPERATORS above.
E2E_ADMIN_OPERATOR=edu
E2E_ADMIN_PASSWORD=creator-outdoor-dev
E2E_ADMIN_TOTP_SECRET=QSRZQA4PSAPBBEK7ERZEBDTIBWXXEJUV
