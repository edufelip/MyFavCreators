# ---------------------------------------------------------------------------
# Creator Outdoor - local development environment
# Copy to .env and adjust. Never commit .env.
# ---------------------------------------------------------------------------

# --- Product configuration (shared, non-secret) ----------------------------
TIMEZONE=America/Sao_Paulo
CURRENCY=BRL
MIN_BOOST_CENTS=500
MIN_INCREMENT_CENTS=100
ROTATION_HOURS=24
ROTATION_FEED_MAX=30
ROTATION_BUCKET_MINUTES=5
SUPPORTER_MESSAGE_MAX=140
SUPPORTER_NAME_MAX=40
SESSION_COOKIE_DAYS=90
SUPPORTER_COOKIE_DAYS=365
WEEK_START=MONDAY_00_00
LAUNCH_CATEGORY=musica
FAKE_PIX_EXPIRATION_MINUTES=30

# --- Origins ---------------------------------------------------------------
WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:3001
ADMIN_ORIGIN=http://localhost:3002

# --- apps/api --------------------------------------------------------------
API_PORT=3001
DATABASE_URL=postgres://creator_outdoor:creator_outdoor@localhost:5432/creator_outdoor
# Used only by `bun run test:integration`. Must NOT point at a database you care about.
TEST_DATABASE_URL=postgres://creator_outdoor:creator_outdoor@localhost:5432/creator_outdoor_test
# Server-only shared secret for apps/admin -> apps/api internal calls (Phase 2).
ADMIN_API_SECRET=dev-admin-api-secret-change-me

# --- apps/web --------------------------------------------------------------
WEB_PORT=3000

# --- apps/admin ------------------------------------------------------------
ADMIN_PORT=3002
