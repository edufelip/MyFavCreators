{
  "name": "creator-outdoor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=24.19.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:generate": "bun run --filter @creator-outdoor/db db:generate",
    "db:migrate": "bun run --filter @creator-outdoor/db db:migrate",
    "db:seed": "bun run --filter @creator-outdoor/db db:seed",
    "db:reset": "bun run --filter @creator-outdoor/db db:reset",
    "prepare": "husky || true",
    "admin:hash": "bun run --cwd packages/config ../../scripts/hash-admin-password.ts",
    "job:weekly-rollover": "bun run --filter @creator-outdoor/api job:weekly-rollover",
    "job:payment-reconcile": "bun run --filter @creator-outdoor/api job:payment-reconcile"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@types/bun": "1.3.14",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "turbo": "2.10.11",
    "typescript": "7.0.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc,css}": [
      "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
    ]
  }
}
