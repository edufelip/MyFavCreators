{
  "name": "@creator-outdoor/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./schema/enums": "./src/schema/enums.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/scripts/migrate.ts",
    "db:seed": "bun run src/scripts/seed.ts",
    "db:reset": "bun run src/scripts/reset.ts",
    "test:unit": "bun test test/unit"
  },
  "dependencies": {
    "@creator-outdoor/config": "workspace:*",
    "@creator-outdoor/domain": "workspace:*",
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.10",
    "typescript": "7.0.2"
  }
}
