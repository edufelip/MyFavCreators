# dependencies
node_modules/

# build output
dist/
build/
.next/
*.tsbuildinfo
# Anchored, so it means "a build directory at the root of a package" and not
# "any directory called out, anywhere". Unanchored, it also swallowed
# apps/web/src/app/out/[creatorLinkId] — the outbound redirect route — which
# meant a fresh clone built a site where every creator's link 404ed.
/out/
apps/*/out/
packages/*/out/

# turbo
.turbo/

# environment
.env
.env.*
!.env.example

# logs
*.log
npm-debug.log*
bun-debug.log*

# test output
coverage/
playwright-report/
test-results/
blob-report/
.playwright/

# code intelligence artifacts
graphify-out/

# local database volumes
.postgres-data/
.tmp/
backups/

# editors / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
.stryker-tmp/
reports/
