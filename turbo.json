{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig.base.json", "biome.json", ".env.example"],
  "globalEnv": [
    "NODE_ENV",
    "TIMEZONE",
    "CURRENCY",
    "MIN_BOOST_CENTS",
    "MIN_INCREMENT_CENTS",
    "ROTATION_HOURS",
    "ROTATION_FEED_MAX",
    "ROTATION_BUCKET_MINUTES",
    "SUPPORTER_MESSAGE_MAX",
    "SUPPORTER_NAME_MAX",
    "SESSION_COOKIE_DAYS",
    "SUPPORTER_COOKIE_DAYS",
    "WEEK_START",
    "LAUNCH_CATEGORY",
    "FAKE_PIX_EXPIRATION_MINUTES",
    "WEB_ORIGIN",
    "API_ORIGIN",
    "ADMIN_ORIGIN",
    "WEB_PORT",
    "API_PORT",
    "ADMIN_PORT",
    "DATABASE_URL",
    "ADMIN_API_SECRET",
    "ADMIN_PASSWORD_HASH",
    "ADMIN_SESSION_SECRET",
    "RATE_LIMIT_SUBMISSIONS_PER_HOUR",
    "RATE_LIMIT_REPORTS_PER_HOUR",
    "RATE_LIMIT_OPT_OUT_REQUESTS_PER_HOUR",
    "RATE_LIMIT_OPT_OUT_VERIFICATIONS_PER_HOUR",
    "RATE_LIMIT_BOOSTS_PER_HOUR",
    "RATE_LIMIT_IMPRESSIONS_PER_MINUTE",
    "FAN_IDENTITY_SECRET",
    "MERCADO_PAGO_ACCESS_TOKEN",
    "MERCADO_PAGO_WEBHOOK_SECRET"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.test.ts", "!**/*.test.tsx", "!e2e/**"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "check": {
      "dependsOn": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["test:unit", "test:integration"]
    },
    "test:unit": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": ["DATABASE_URL", "TEST_DATABASE_URL"],
      "outputs": []
    },
    "test:e2e": {
      "dependsOn": ["build", "@creator-outdoor/admin#build"],
      "cache": false,
      "env": [
        "DATABASE_URL",
        "TEST_DATABASE_URL",
        "WEB_ORIGIN",
        "API_ORIGIN",
        "WEB_PORT",
        "API_PORT",
        "PLAYWRIGHT_BROWSERS_PATH",
        "PLAYWRIGHT_CHROMIUM_EXECUTABLE",
        "ADMIN_ORIGIN",
        "ADMIN_API_SECRET",
        "ADMIN_PASSWORD_HASH",
        "ADMIN_SESSION_SECRET",
        "E2E_ADMIN_PASSWORD",
        "ADMIN_PORT",
        "FAN_IDENTITY_SECRET"
      ],
      "outputs": []
    }
  }
}
